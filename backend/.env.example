# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# Used to sign the (fake) auth token. Set a real random value in any shared environment.
SECRET_KEY=change-me-in-production

# SQLAlchemy connection string for PostgreSQL
DATABASE_URL=postgresql://taskflow_user:taskflow_pass@localhost:5432/taskflow_db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port the app listens on when run via wsgi.py directly
PORT=5000

# Chat assistant (Groq Responses API + remote MCP server)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MCP_SERVER_URL=
MCP_SERVER_LABEL=taskflow-mcp
